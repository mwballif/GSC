. *--- compare -------------------------------------------------------------------
. * Scale-aware, as in the R port's validate.R: differences of two large numbers
. * (nx) and shares near zero both make a plain relative deviation misleading, so
. * every column is scaled by its own root mean square.
. 
. capture program drop gsc_cmp

. program define gsc_cmp
  1.     syntax anything(name=fname), Keys(string)
  2. 
.     local base "../../../data/processed"
  3.     local test "$GSC_PROC"
  4. 
.     di ""
  5.     di as txt "== `fname' =="
  6. 
.     tempfile A B
  7. 
.     import delimited "`base'/`fname'", clear
  8.     local nA = _N
  9.     quietly ds, has(type numeric)
 10.     local numA "`r(varlist)'"
 11.     save `A'
 12. 
.     import delimited "`test'/`fname'", clear
 13.     local nB = _N
 14.     save `B'
 15. 
.     di as txt "   rows: baseline `nA', this copy `nB'"
 16. 
.     * Numeric columns to compare, excluding the merge keys.
.     local cmpvars ""
 17.     foreach v of local numA {
 18.         local iskey 0
 19.         foreach k of local keys {
 20.             if "`v'" == "`k'" local iskey 1
 21.         }
 22.         if !`iskey' local cmpvars "`cmpvars' `v'"
 23.     }
 24. 
.     use `A', clear
 25.     foreach v of local cmpvars {
 26.         rename `v' `v'_s
 27.     }
 28.     keep `keys' *_s
 29.     merge 1:1 `keys' using `B', keep(3) nogen
 30.     di as txt "   matched rows: " _N
 31. 
.     foreach v of local cmpvars {
 32.         capture confirm numeric variable `v'
 33.         if _rc {
 34.             di as txt "     " %-13s "`v'" "  absent from this copy"
 35.             continue
 36.         }
 37.         quietly gen double _d  = abs(`v' - `v'_s)
 38.         quietly gen double _sq = `v'_s^2
 39.         quietly su _sq, meanonly
 40.         local scl = sqrt(r(mean))
 41.         quietly su _d, meanonly
 42.         local dev = r(max) / max(`scl', 1e-12)
 43.         local flag "match"
 44.         if `dev' > 1e-6 local flag "DIFF"
 45.         di as txt "     " %-13s "`v'" "  max dev / scale " as res %9.3e `dev' as txt "   
> `flag'"
 46.         drop _d _sq
 47.     }
 48. end

. 
. gsc_cmp CountryPanel_2country.csv,       keys(country year)

