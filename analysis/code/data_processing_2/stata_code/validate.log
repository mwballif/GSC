. do validate.do 

. *==============================================================================
. * validate.do
. *
. * Purpose: Check this arm's do-files against the baseline Stata output.
. * Reads:   data/processed/panel_A-C.csv and the baseline _2country panels
. * Writes:  a scratch copy of the panels in /tmp/gsc_validate, plus a report
. *
. * Runs the builders here on the BASELINE panels with $GSC_TRADE_TO_GOODS = 0, so
. * the sector definition matches data_processing/. Any difference from the CSVs
. * that data_processing/stata_code/run.do wrote is a bug in this copy, not in the
. * experiment, because the experiment lives in the MATLAB extractors and in the
. * sector maps this run switches off.
. *
. /* NOTE: writes to a scratch directory, never to data/processed. */
. /* NOTE: run this from stata_code/, like every other file here. */
. *==============================================================================
. 
. * Point the builders at the scratch directory and turn the experiment off.
. * 0_setup.do sets its globals only when empty, so these win.
. global GSC_PROC "/tmp/gsc_validate"

. global GSC_TRADE_TO_GOODS 0

. 
. capture mkdir "/tmp/gsc_validate"

. capture mkdir "/tmp/gsc_validate/intermediate"

. 
. foreach p in panel_A panel_B panel_C {
  2.     copy "../../../data/processed/`p'.csv" "$GSC_PROC/`p'.csv", replace
  3. }

. 
. *--- run the builders in run.do's order ----------------------------------------
. 
. do "1_process_raw_data.do"

. *==============================================================================
. * 1_process_raw_data.do
. *
. * Purpose: Convert the raw spreadsheets and MATLAB panels into .dta files.
. * Reads:   the raw xlsx workbooks, panel_A-C.csv, the country crosswalk
. * Writes:  dta copies of all of them, in $GSC_INTER
. *
. /* NOTE: skipping this leaves panel_A.dta stale and every panel wrong. */
. /* NOTE: unlike the baseline, the crosswalk .dta is written to this arm's  */
. /* intermediate folder rather than data/crosswalks/, so nothing here writes */
. /* outside $GSC_PROC. The .csv it comes from is shared and unmodified.      */
. *==============================================================================
. 
. do "0_setup.do"

. *==============================================================================
. * 0_setup.do
. *
. * Purpose: Hold the paths and the experiment's sector definition in one place.
. * Reads:   nothing
. * Writes:  nothing; sets globals
. *
. * Every do-file here runs this first, so each one also works standalone. Globals
. * are set only when empty, which is how validate.do points the same code at the
. * baseline panels.
. *
. /* NOTE: the baseline in data_processing/ hardcodes its paths and has no setup */
. /* file. This one exists because the sector switch has to reach three do-files. */
. *==============================================================================
. 
. * Input and output directory. The MATLAB extractors write panel_A-D here and
. * every panel built below is written back here.
. if "$GSC_PROC"  == "" global GSC_PROC  "../../../data/processed_2"

. if "$GSC_RAW"   == "" global GSC_RAW   "../../../data/raw"

. if "$GSC_CROSS" == "" global GSC_CROSS "../../../data/crosswalks"

. 
. global GSC_INTER "$GSC_PROC/intermediate"

. 
. capture mkdir "$GSC_PROC"

. capture mkdir "$GSC_INTER"

. 
. *--- the experiment switch -----------------------------------------------------
. * 1 puts distributive trade in MAN rather than SER, which is the experiment.
. * 0 restores the baseline sector definition; validate.do uses that to separate
. * the port from the experiment.
. if "$GSC_TRADE_TO_GOODS" == "" global GSC_TRADE_TO_GOODS 1

. 
. *--- sector maps ---------------------------------------------------------------
. * These must match the M_sectors vectors in the MATLAB extractors, because the
. * price index has to use the same sector definition as the quantities it
. * deflates. Three maps move:
. *
. *   LR socio-economic accounts   GtH   from SER to MAN
. *   WIOD 2016 accounts           G*, I from SER to MAN   (handled in PART 3)
. *   PLD 2023 subsectors          trd   from SER to MAN   (trd is G plus I)
. *
. /* NOTE: hotels and restaurants travel with trade because the LR accounts */
. /* report G and H as the single code GtH and cannot split them.           */
. 
. if $GSC_TRADE_TO_GOODS {
.     global MAN_LR  "CtE GtH"
.     global SER_LR  "F I JtQ"
.     global MAN_PLD "min man pu trd"
.     global SER_PLD "con tra bus fin dwe pub oth"
. }

. else {
.     global MAN_LR  "CtE"
.     global SER_LR  "F GtH I JtQ"
.     global MAN_PLD "min man pu"
.     global SER_PLD "con trd tra bus fin dwe pub oth"
. }

. 
. di as txt "0_setup.do: writing to $GSC_PROC, trade_to_goods = $GSC_TRADE_TO_GOODS"
0_setup.do: writing to /tmp/gsc_validate, trade_to_goods = 0

. 
end of do-file

. 
. * Long Run WIOD socio-economic accounts.
. import excel using "$GSC_RAW/lr_wiod_sea_final.xlsx", sheet("data") firstrow clear
(40 vars, 14,125 obs)

. compress
  (0 bytes saved)

. save "$GSC_INTER/lr_wiod_sea_final.dta", replace
file /tmp/gsc_validate/intermediate/lr_wiod_sea_final.dta saved

. 
. * WIOD 2016 socio-economic accounts.
. import excel using "$GSC_RAW/Socio_economic_Accounts.xlsx", sheet("DATA") firstrow clear
(19 vars, 38,528 obs)

. compress
  (0 bytes saved)

. save "$GSC_INTER/Socio_economic_Accounts.dta", replace
file /tmp/gsc_validate/intermediate/Socio_economic_Accounts.dta saved

. 
. * GGDC Productivity Level Database, for the 2005 gross-output PPPs.
. import excel using "$GSC_RAW/pld2023_dataset.xlsx", sheet("Data") firstrow clear
(10 vars, 3,024 obs)

. compress
  (0 bytes saved)

. save "$GSC_INTER/pld2023_dataset.dta", replace
file /tmp/gsc_validate/intermediate/pld2023_dataset.dta saved

. 
. * Penn World Table.
. import excel using "$GSC_RAW/pwt110.xlsx", sheet("Data") firstrow clear
(51 vars, 1,048,575 obs)

. save "$GSC_INTER/pwt110.dta", replace
file /tmp/gsc_validate/intermediate/pwt110.dta saved

. 
. * Country aggregates from the MATLAB extractors.
. capture confirm file "$GSC_PROC/panel_A.csv"

. if _rc {
.     di as error "panel_A.csv not found in $GSC_PROC."
.     di as error "Run the MATLAB extractors first: cd ../matlab; process_raw_data; createpane
> ls"
.     exit 601
. }

. import delimited "$GSC_PROC/panel_A.csv", clear
(encoding automatically selected: ISO-8859-1)
(8 vars, 1,275 obs)

. save "$GSC_INTER/panel_A.dta", replace
file /tmp/gsc_validate/intermediate/panel_A.dta saved

. 
. * Country-sector quantities.
. import delimited "$GSC_PROC/panel_B.csv", clear
(encoding automatically selected: ISO-8859-1)
(12 vars, 3,825 obs)

. save "$GSC_INTER/panel_B.dta", replace
file /tmp/gsc_validate/intermediate/panel_B.dta saved

. 
. * Bilateral trade flows.
. import delimited "$GSC_PROC/panel_C.csv", clear
(encoding automatically selected: ISO-8859-1)
(7 vars, 95,625 obs)

. save "$GSC_INTER/panel_C.dta", replace
file /tmp/gsc_validate/intermediate/panel_C.dta saved

. 
. * Country name to number crosswalk.
. *
. /* NOTE: panel_D.csv is not converted. Nothing in the Stata half reads it; */
. /* recover_parameters.m reads the csv directly.                            */
. import delimited "$GSC_CROSS/country_num_crosswalk.csv", clear
(encoding automatically selected: ISO-8859-1)
(4 vars, 25 obs)

. save "$GSC_INTER/country_num_crosswalk.dta", replace
file /tmp/gsc_validate/intermediate/country_num_crosswalk.dta saved

. 
end of do-file

. do "makeImpExpSectorPanel.do"

. *==============================================================================
. * makeImpExpSectorPanel.do
. *
. * Purpose: Splice the bilateral trade matrix at 2000 and write its totals.
. * Reads:   $GSC_INTER/panel_C.dta, the country crosswalk
. * Writes:  ImpExpSectorPanel.csv, ImpExpSectorPanel_2country.csv,
. *          $GSC_INTER/bilateral_totals.dta
. *
. /* NOTE: runs first. Every trade quantity is read off this one spliced matrix. */
. *==============================================================================
. 
. do "0_setup.do"

. *==============================================================================
. * 0_setup.do
. *
. * Purpose: Hold the paths and the experiment's sector definition in one place.
. * Reads:   nothing
. * Writes:  nothing; sets globals
. *
. * Every do-file here runs this first, so each one also works standalone. Globals
. * are set only when empty, which is how validate.do points the same code at the
. * baseline panels.
. *
. /* NOTE: the baseline in data_processing/ hardcodes its paths and has no setup */
. /* file. This one exists because the sector switch has to reach three do-files. */
. *==============================================================================
. 
. * Input and output directory. The MATLAB extractors write panel_A-D here and
. * every panel built below is written back here.
. if "$GSC_PROC"  == "" global GSC_PROC  "../../../data/processed_2"

. if "$GSC_RAW"   == "" global GSC_RAW   "../../../data/raw"

. if "$GSC_CROSS" == "" global GSC_CROSS "../../../data/crosswalks"

. 
. global GSC_INTER "$GSC_PROC/intermediate"

. 
. capture mkdir "$GSC_PROC"

. capture mkdir "$GSC_INTER"

. 
. *--- the experiment switch -----------------------------------------------------
. * 1 puts distributive trade in MAN rather than SER, which is the experiment.
. * 0 restores the baseline sector definition; validate.do uses that to separate
. * the port from the experiment.
. if "$GSC_TRADE_TO_GOODS" == "" global GSC_TRADE_TO_GOODS 1

. 
. *--- sector maps ---------------------------------------------------------------
. * These must match the M_sectors vectors in the MATLAB extractors, because the
. * price index has to use the same sector definition as the quantities it
. * deflates. Three maps move:
. *
. *   LR socio-economic accounts   GtH   from SER to MAN
. *   WIOD 2016 accounts           G*, I from SER to MAN   (handled in PART 3)
. *   PLD 2023 subsectors          trd   from SER to MAN   (trd is G plus I)
. *
. /* NOTE: hotels and restaurants travel with trade because the LR accounts */
. /* report G and H as the single code GtH and cannot split them.           */
. 
. if $GSC_TRADE_TO_GOODS {
.     global MAN_LR  "CtE GtH"
.     global SER_LR  "F I JtQ"
.     global MAN_PLD "min man pu trd"
.     global SER_PLD "con tra bus fin dwe pub oth"
. }

. else {
.     global MAN_LR  "CtE"
.     global SER_LR  "F GtH I JtQ"
.     global MAN_PLD "min man pu"
.     global SER_PLD "con trd tra bus fin dwe pub oth"
. }

. 
. di as txt "0_setup.do: writing to $GSC_PROC, trade_to_goods = $GSC_TRADE_TO_GOODS"
0_setup.do: writing to /tmp/gsc_validate, trade_to_goods = 0

. 
end of do-file

. 
. *--- PART 1: splice the bilateral flows and import shares ----------------------
. 
. use "$GSC_INTER/panel_C.dta", clear

. 
. * Compute WIOD growth rates.
. /* NOTE: source must be in the sort, or the 2000 rows tie. */
. local vars "imp_sh trade_flow"

. sort exporter importer sector year source

. foreach var of local vars {
  2.     by exporter importer sector: gen `var'_gr = `var'/`var'[_n-1] if source == 1 & year !
> = 2000
  3. }
(69,378 missing values generated)
(69,378 missing values generated)

. 
. * Start the spliced series at the Long Run levels.
. foreach var of local vars {
  2.     gen `var'_spliced = `var' if source == 0
  3. }
(28,125 missing values generated)
(28,125 missing values generated)

. 
. * Keep the Long Run version of the 2000 splice point.
. drop if year == 2000 & source == 1
(1,875 observations deleted)

. 
. * Extend forward using the WIOD growth rates.
. sort exporter importer sector year

. foreach var of local vars {
  2.     bysort exporter importer sector (year): replace `var'_spliced = `var'_spliced[_n-1] *
>  `var'_gr if source == 1
  3. }
(26,224 real changes made)
(26,224 real changes made)

. 
. foreach var of local vars {
  2.     replace `var' = `var'_spliced
  3. }
(26,249 real changes made, 26 to missing)
(26,249 real changes made, 26 to missing)

. 
. * Attach country names to the exporter and importer codes.
. rename exporter exporter_numcode

. rename importer importer_numcode

. 
. merge m:1 exporter_numcode using "$GSC_INTER/country_num_crosswalk.dta", keepusing(country) 
> nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            93,750  
    -----------------------------------------

. rename country exporter

. 
. merge m:1 importer_numcode using "$GSC_INTER/country_num_crosswalk.dta", keepusing(country) 
> nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            93,750  
    -----------------------------------------

. rename country importer

. drop importer_numcode exporter_numcode

. 
. * Label the three sectors.
. rename sector sector_num

. gen sector = "AGR" if sector_num == 1
(62,500 missing values generated)

. replace sector = "MAN" if sector_num == 2
(31,250 real changes made)

. replace sector = "SER" if sector_num == 3
(31,250 real changes made)

. 
. sort importer exporter sector year

. keep exporter importer year sector `vars'

. 
. export delimited "$GSC_PROC/ImpExpSectorPanel.csv", replace
file /tmp/gsc_validate/ImpExpSectorPanel.csv saved

. 
. *--- PART 1b: row and column totals of the spliced matrix ----------------------
. *
. * go_mat   gross output = flows FROM this region, summed over importers
. * exp_mat  total expend = flows TO   this region, summed over exporters
. * xp_mat   exports      = go_mat  minus the own (diagonal) flow
. * mp_mat   imports      = exp_mat minus the own (diagonal) flow
. * nx_mat   net exports  = xp_mat - mp_mat, identically go_mat - exp_mat
. *
. /* NOTE: derived from one matrix, so world net exports sum to zero exactly. */
. 
. tempfile bilat marg_out

. 
. preserve

. 
. * Isolate the diagonal so exports and imports can net it out.
. gen double own = trade_flow if exporter == importer
(90,000 missing values generated)

. save `bilat'
file /var/folders/y5/6sm5wg5n2w1_7tprfw_w8cxh0000gn/T//S_23383.000001 saved as .dta format

. 
. * Gross output and exports, by producing region.
. collapse (sum) go_mat = trade_flow own_o = own, by(exporter sector year)

. rename exporter country

. gen double xp_mat = go_mat - own_o

. drop own_o

. save `marg_out'
file /var/folders/y5/6sm5wg5n2w1_7tprfw_w8cxh0000gn/T//S_23383.000002 saved as .dta format

. 
. * Total expenditure and imports, by buying region.
. use `bilat', clear

. collapse (sum) exp_mat = trade_flow own_i = own, by(importer sector year)

. rename importer country

. gen double mp_mat = exp_mat - own_i

. drop own_i

. 
. * Combine the two sides and form net exports.
. merge 1:1 country sector year using `marg_out', nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                             3,750  
    -----------------------------------------

. gen double nx_mat = xp_mat - mp_mat

. 
. label var go_mat  "gross output, row sum of the spliced bilateral matrix"

. label var exp_mat "total expenditure, column sum of the spliced bilateral matrix"

. label var xp_mat  "exports, off-diagonal row sum"

. label var mp_mat  "imports, off-diagonal column sum"

. label var nx_mat  "net exports, xp_mat - mp_mat"

. 
. sort country sector year

. save "$GSC_INTER/bilateral_totals.dta", replace
file /tmp/gsc_validate/intermediate/bilateral_totals.dta saved

. 
. restore

. 
. *--- PART 2: USA vs ROW two country aggregation --------------------------------
. *
. /* NOTE: intra-ROW trade becomes domestic in the ROW-to-ROW cell. */
. 
. gen byte exp_usa = exporter == "USA"

. gen byte imp_usa = importer == "USA"

. 
. collapse (sum) trade_flow, by(sector year exp_usa imp_usa)

. 
. gen exporter = cond(exp_usa, "USA", "ROW")

. gen importer = cond(imp_usa, "USA", "ROW")

. drop exp_usa imp_usa

. 
. * Import shares: the importer's spending by origin, summing to one over origins.
. bysort importer sector year: egen total_spend = total(trade_flow)

. gen imp_sh = trade_flow / total_spend

. drop total_spend

. 
. * Export shares: the exporter's sales by destination.
. bysort exporter sector year: egen total_sales = total(trade_flow)

. gen exp_sh = trade_flow / total_sales

. drop total_sales

. 
. order exporter importer sector year imp_sh exp_sh trade_flow

. sort exporter importer sector year

. 
. export delimited "$GSC_PROC/ImpExpSectorPanel_2country.csv", replace
file /tmp/gsc_validate/ImpExpSectorPanel_2country.csv saved

. 
end of do-file

. do "makecountrypanel.do"

. *==============================================================================
. * makecountrypanel.do
. *
. * Purpose: Build the country-level panel, 1965-2014, for 25 regions and for the
. *          two-country USA/ROW system.
. * Reads:   $GSC_INTER/panel_A.dta, pwt110.dta, bilateral_totals.dta
. * Writes:  CountryPanel.csv, CountryPanel_2country.csv
. *
. /* NOTE: makeImpExpSectorPanel.do must run first; this reads its totals. */
. *==============================================================================
. 
. do "0_setup.do"

. *==============================================================================
. * 0_setup.do
. *
. * Purpose: Hold the paths and the experiment's sector definition in one place.
. * Reads:   nothing
. * Writes:  nothing; sets globals
. *
. * Every do-file here runs this first, so each one also works standalone. Globals
. * are set only when empty, which is how validate.do points the same code at the
. * baseline panels.
. *
. /* NOTE: the baseline in data_processing/ hardcodes its paths and has no setup */
. /* file. This one exists because the sector switch has to reach three do-files. */
. *==============================================================================
. 
. * Input and output directory. The MATLAB extractors write panel_A-D here and
. * every panel built below is written back here.
. if "$GSC_PROC"  == "" global GSC_PROC  "../../../data/processed_2"

. if "$GSC_RAW"   == "" global GSC_RAW   "../../../data/raw"

. if "$GSC_CROSS" == "" global GSC_CROSS "../../../data/crosswalks"

. 
. global GSC_INTER "$GSC_PROC/intermediate"

. 
. capture mkdir "$GSC_PROC"

. capture mkdir "$GSC_INTER"

. 
. *--- the experiment switch -----------------------------------------------------
. * 1 puts distributive trade in MAN rather than SER, which is the experiment.
. * 0 restores the baseline sector definition; validate.do uses that to separate
. * the port from the experiment.
. if "$GSC_TRADE_TO_GOODS" == "" global GSC_TRADE_TO_GOODS 1

. 
. *--- sector maps ---------------------------------------------------------------
. * These must match the M_sectors vectors in the MATLAB extractors, because the
. * price index has to use the same sector definition as the quantities it
. * deflates. Three maps move:
. *
. *   LR socio-economic accounts   GtH   from SER to MAN
. *   WIOD 2016 accounts           G*, I from SER to MAN   (handled in PART 3)
. *   PLD 2023 subsectors          trd   from SER to MAN   (trd is G plus I)
. *
. /* NOTE: hotels and restaurants travel with trade because the LR accounts */
. /* report G and H as the single code GtH and cannot split them.           */
. 
. if $GSC_TRADE_TO_GOODS {
.     global MAN_LR  "CtE GtH"
.     global SER_LR  "F I JtQ"
.     global MAN_PLD "min man pu trd"
.     global SER_PLD "con tra bus fin dwe pub oth"
. }

. else {
.     global MAN_LR  "CtE"
.     global SER_LR  "F GtH I JtQ"
.     global MAN_PLD "min man pu"
.     global SER_PLD "con trd tra bus fin dwe pub oth"
. }

. 
. di as txt "0_setup.do: writing to $GSC_PROC, trade_to_goods = $GSC_TRADE_TO_GOODS"
0_setup.do: writing to /tmp/gsc_validate, trade_to_goods = 0

. 
end of do-file

. 
. *--- PART 1: Penn World Table variables ----------------------------------------
. 
. use "$GSC_INTER/pwt110.dta", clear

. keep countrycode year emp pop rnna cn pl_c pl_i xr cgdpo

. rename countrycode country

. rename rnna k_stock

. rename pl_c consump_pi

. rename pl_i invest_pi

. drop if year < 1965 | year > 2014
(1,039,325 observations deleted)

. 
. * Split PWT into the WIOD countries and everything else.
. merge m:1 country using "$GSC_INTER/country_num_crosswalk.dta", keep(1 3)

    Result                      Number of obs
    -----------------------------------------
    Not matched                         8,050
        from master                     8,050  (_merge==1)
        from using                          0  (_merge==2)

    Matched                             1,200  (_merge==3)
    -----------------------------------------

. 
. * Build the residual region from the non-WIOD countries: sum the quantities and
. * take GDP-weighted geometric means of the price levels.
. *
. /* NOTE: the residual region's capital jumps 137% in 1990. See the appendix. */
. preserve

. keep if _merge == 1
(1,200 observations deleted)

. bysort year: egen totw_c = total(cond(!missing(consump_pi), cgdpo, .))

. bysort year: egen totw_i = total(cond(!missing(invest_pi),  cgdpo, .))

. gen wln_consump_pi = cgdpo / totw_c * ln(consump_pi)
(942 missing values generated)

. gen wln_invest_pi  = cgdpo / totw_i * ln(invest_pi)
(942 missing values generated)

. 
. collapse (sum) emp pop k_stock cn wln_*, by(year)

. 
. gen consump_pi = exp(wln_consump_pi)

. gen invest_pi  = exp(wln_invest_pi)

. drop wln_*

. gen country = "ROW"

. tempfile penn_row

. save `penn_row'
file /var/folders/y5/6sm5wg5n2w1_7tprfw_w8cxh0000gn/T//S_23383.000002 saved as .dta format

. restore

. 
. * Keep the WIOD countries and append the residual region.
. keep if _merge == 3
(8,050 observations deleted)

. drop _merge country_numcode exporter_numcode importer_numcode cgdpo

. append using `penn_row'

. tempfile penn

. save `penn'
file /var/folders/y5/6sm5wg5n2w1_7tprfw_w8cxh0000gn/T//S_23383.000003 saved as .dta format

. 
. *--- PART 2: splice the country aggregates -------------------------------------
. 
. use "$GSC_INTER/panel_A.dta", clear

. rename country country_numcode

. 
. merge m:1 country_numcode using "$GSC_INTER/country_num_crosswalk.dta", nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                             1,275  
    -----------------------------------------

. sort country year

. 
. * Chain-link GDP, consumption and investment at 2000.
. *
. /* NOTE: tot_exp and tot_imp are not spliced here; they come from the matrix. */
. local vars "gdp tot_consump tot_invest"

. sort country year source

. foreach var of local vars {
  2.     bysort country (year): gen `var'_gr = `var'/`var'[_n-1] if source == 1 & year != 2000
  3. }
(925 missing values generated)
(925 missing values generated)
(925 missing values generated)

. 
. * Start the spliced series at the Long Run levels.
. foreach var of local vars {
  2.     gen `var'_spliced = `var' if source == 0
  3. }
(375 missing values generated)
(375 missing values generated)
(375 missing values generated)

. 
. * Keep the Long Run version of the 2000 splice point.
. drop if year == 2000 & source == 1
(25 observations deleted)

. 
. * Extend forward using the WIOD growth rates.
. sort country year

. foreach var of local vars {
  2.     bysort country (year): replace `var'_spliced = `var'_spliced[_n-1] * `var'_gr if sour
> ce == 1
  3. }
(350 real changes made)
(350 real changes made)
(350 real changes made)

. 
. foreach var of local vars {
  2.     replace `var' = `var'_spliced
  3. }
(350 real changes made)
(350 real changes made)
(350 real changes made)

. 
. * Take exports and imports from the spliced bilateral matrix, summed over
. * sectors, and form net exports from them.
. drop tot_exp tot_imp

. preserve

. use "$GSC_INTER/bilateral_totals.dta", clear

